# Plantilla de variables de entorno.
# Copia este fichero como .env (ignorado por git) y rellena tus valores:
#   cp .env.example .env
# Quarkus lee .env automáticamente al arrancar desde esta carpeta
# (./mvnw quarkus:dev o java -jar target/quarkus-app/quarkus-run.jar).

# Obligatoria: clave de Google Gemini (https://aistudio.google.com)
GEMINI_API_KEY=

# Opcional: modelo de Gemini (por defecto gemini-3.8-flash). Lista los disponibles para tu clave en
# https://aistudio.google.com o cambia aquí si Google retira o satura un modelo.
# GEMINI_MODEL=gemini-3.8-flash

# Obligatorias solo en modo producción (java -jar). En dev hay valores locales por defecto.
# ADMIN_KEY=
# BOOTSTRAP_ADMIN_PASSWORD=

# Opcionales: conexión a PostgreSQL (por defecto, la base local del README)
# DB_URL=jdbc:postgresql://localhost:5432/asistente_contextual
# DB_USER=postgres
# DB_PASSWORD=postgres

# Opcionales: rutas de las claves JWT (por defecto, keys/)
# JWT_PRIVATE_KEY_LOCATION=keys/privateKey.pem
# JWT_PUBLIC_KEY_LOCATION=keys/publicKey.pem
