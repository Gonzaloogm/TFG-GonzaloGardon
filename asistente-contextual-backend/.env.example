# Plantilla de variables de entorno.
# Copia este fichero como .env (ignorado por git) y rellena tus valores:
#   cp .env.example .env
# Lo usan tanto Quarkus (./mvnw quarkus:dev o java -jar, desde esta carpeta)
# como Docker Compose (docker compose up --build).

# Obligatoria: clave de Google Gemini (https://aistudio.google.com)
GEMINI_API_KEY=

# Opcionales: modelos de Gemini. Cámbialos si Google retira o satura alguno
# (los disponibles para tu clave aparecen en https://aistudio.google.com).
# GEMINI_MODEL: modelo principal del chat.
# GEMINI_AUX_MODEL: modelo ligero para reformular las consultas antes de buscar.
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_AUX_MODEL=gemini-3.5-flash-lite

# Obligatorias en modo producción (java -jar y Docker Compose). En dev hay valores locales por defecto.
# ADMIN_KEY=
# BOOTSTRAP_ADMIN_PASSWORD=

# Opcionales: conexión a PostgreSQL (por defecto, la base local del README)
# DB_URL=jdbc:postgresql://localhost:5432/asistente_contextual
# DB_USER=postgres
# DB_PASSWORD=postgres

# Opcionales: rutas de las claves JWT (por defecto, keys/)
# JWT_PRIVATE_KEY_LOCATION=keys/privateKey.pem
# JWT_PUBLIC_KEY_LOCATION=keys/publicKey.pem

# Opcional: puerto publicado por Docker Compose (por defecto 8080)
# APP_PORT=8080
